[Unit]
Description=AXEN Intelligence — Timer do backup diário do axen.db (item 0.7)

[Timer]
# OnCalendar é interpretado no horário LOCAL do servidor (não BRT
# explicitamente — systemd não aceita fuso embutido em OnCalendar).
# Confirmado em produção (16/09/2026, `timedatectl show --property=Timezone`)
# que o servidor roda em Etc/UTC — por isso 06:00 aqui (03:00 BRT = 06:00 UTC).
# Se um dia o servidor mudar pra America/Sao_Paulo
# (`timedatectl set-timezone America/Sao_Paulo`), troque para 03:00.
OnCalendar=*-*-* 06:00:00
Persistent=true
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
