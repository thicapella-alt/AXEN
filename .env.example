# ─────────────────────────────────────────────────────────────────────────────
# AXEN Intelligence — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NUNCA deve ser commitado no repositório.
# ─────────────────────────────────────────────────────────────────────────────

# ── Banco de dados ────────────────────────────────────────────────────────────
# Caminho para o arquivo SQLite. Padrão: axen.db na raiz do projeto.
DB_PATH=axen.db

# ── Mercado Livre ─────────────────────────────────────────────────────────────
# Habilita a integração com a API do Mercado Livre.
# Defina como "true" apenas quando as credenciais abaixo estiverem preenchidas.
MERCADOLIVRE_ENABLED=false

# Credenciais OAuth 2.0 da aplicação criada em https://developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=

# ID do vendedor (seller_id) — visível no painel do Mercado Livre
ML_SELLER_ID=

# ── Nuvemshop ─────────────────────────────────────────────────────────────────
# Habilita a integração com a API da Nuvemshop (requer plano com API).
NUVEMSHOP_ENABLED=false

# Access token gerado no painel de parceiros da Nuvemshop
NUVEMSHOP_ACCESS_TOKEN=

# ID da loja (user_id) — presente na URL do painel Nuvemshop
NUVEMSHOP_USER_ID=

# ── Nuvemshop Scraper (sem necessidade de plano com API) ─────────────────────
# Credenciais de login no painel admin da Nuvemshop
NUVEMSHOP_EMAIL=
NUVEMSHOP_PASSWORD=

# URL base da loja (sem /admin no final)
NUVEMSHOP_STORE_URL=https://testenuvemenvio.lojavirtualnuvem.com.br

# ── Shopee ────────────────────────────────────────────────────────────────────
# Habilita a integração com a API da Shopee (Partner API v2).
SHOPEE_ENABLED=false

# Credenciais do aplicativo criado em https://open.shopee.com
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# Tokens de acesso à loja (gerados via fluxo OAuth da Shopee)
SHOPEE_ACCESS_TOKEN=
SHOPEE_SHOP_ID=
